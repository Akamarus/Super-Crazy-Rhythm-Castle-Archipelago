<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\RootsPresentationPolicy.cs" Link="RootsPresentationPolicy.cs" />
    <Compile Include="..\..\RootsPostLevelOnePresentation.cs" Link="RootsPostLevelOnePresentation.cs" />
    <Compile Include="..\..\RootsComputerPolicy.cs" Link="RootsComputerPolicy.cs" />
    <Compile Include="..\..\MeatAreaPresentationPolicy.cs" Link="MeatAreaPresentationPolicy.cs" />
    <Compile Include="..\..\AreaAccessDestinationPolicy.cs" Link="AreaAccessDestinationPolicy.cs" />
    <Compile Include="..\..\MeatMouseEscortRecoveryPolicy.cs" Link="MeatMouseEscortRecoveryPolicy.cs" />
    <Compile Include="..\..\MeatMouseEscortCharacterReader.cs" Link="MeatMouseEscortCharacterReader.cs" />
    <Compile Include="..\..\AreaAccessSessionPolicy.cs" Link="AreaAccessSessionPolicy.cs" />
  </ItemGroup>
  <Target Name="CompileAreaAccess" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <PluginSource>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../../Plugin.cs'))</PluginSource>
      <AreaSource>$([System.Text.RegularExpressions.Regex]::Match('$(PluginSource)', '(?ms)^internal static class AreaAccessPrototype\b.*?^}').Value)</AreaSource>
    </PropertyGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)AreaAccessPrototype.cs" Lines="namespace RhythmCastleAP%3B $(AreaSource)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup><Compile Include="$(IntermediateOutputPath)AreaAccessPrototype.cs" /></ItemGroup>
  </Target>
</Project>
